/* =====================================================================
   DETECTION: Brute Force / Password Spraying
   ATT&CK: T1110.001 - Brute Force: Password Guessing
   Tactic: Credential Access
   ---------------------------------------------------------------------
   Fires when a single source IP generates >= 10 failed logons inside a
   5-minute window. Covers Windows (EventCode 4625) and Linux SSH
   ("Failed password") sources. Tune the threshold to your baseline.
   ===================================================================== */

(index=wineventlog EventCode=4625) OR (index=syslog "Failed password")
| eval src_ip=coalesce(src_ip, IpAddress),
       user=coalesce(TargetUserName, user)
| rex field=_raw "Failed password for (invalid user )?(?<ssh_user>\S+) from (?<ssh_ip>\S+)"
| eval src_ip=coalesce(src_ip, ssh_ip), user=coalesce(user, ssh_user)
| bin _time span=5m
| stats count as failures,
        dc(user) as targeted_accounts,
        values(user) as users
    by src_ip, _time
| where failures >= 10
| eval severity=case(targeted_accounts >= 5, "critical", true(), "high"),
       tactic="Credential Access",
       technique="T1110.001"
| table _time, src_ip, failures, targeted_accounts, users, severity, tactic, technique
| sort - failures
